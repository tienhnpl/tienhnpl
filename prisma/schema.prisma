// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "dart run orm"
  output   = "../lib/prisma_client.dart"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  priority     Priority @default(Medium)
  dueDate      DateTime?
  externalLink String?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now()) // Thêm để theo dõi ngày tạo
}

// Định nghĩa Enum cho Priority
enum Priority {
  High
  Medium
  Low
}
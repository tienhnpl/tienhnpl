@model ComicBook
@{
    ViewData["Title"] = "Create Comic Book";
}

<h1>Create Comic Book</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Title</label>
        <input class="form-control" asp-for="Title" />
    </div>
    <div class="form-group">
        <label>Author</label>
        <input class="form-control" asp-for="Author" />
    </div>
    <div class="form-group">
        <label>Price</label>
        <input class="form-control" asp-for="PricePerDay" type="number" step="0.01" />
    </div>
    <button class="btn btn-primary" type="submit">Create</button>
</form>